# DevGuardian environment configuration
# Copy this file to .env and fill in real values.
# Any value left blank keeps that integration in MOCK MODE (fully demo-able offline).

# NVIDIA NIM — build.nvidia.com/settings/api-keys (starts with nvapi-)
NVIDIA_API_KEY=

# GitHub PAT — scopes: repo, read:user, write:discussion
GITHUB_TOKEN=

# Shared secret — set the SAME value here and in the GitHub webhook settings.
# Generate a random one, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Demo repository
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=devguardian-demo

# Discord incoming webhook URL (Teams-compatible alert channel)
TEAMS_WEBHOOK_URL=

# Storage
DATABASE_PATH=devguardian.db
CHROMA_PATH=.chroma

# Server
PORT=8000
